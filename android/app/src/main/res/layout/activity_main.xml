<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000">
    <SurfaceView android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="match_parent" />
    <Button android:id="@+id/btnQ" android:layout_width="80dp" android:layout_height="50dp" android:text="QUIT"
        android:layout_alignParentTop="true" android:layout_alignParentRight="true" android:layout_margin="20dp" 
        android:background="#88FF0000" android:textColor="#FFF"/>
    <RelativeLayout android:layout_width="200dp" android:layout_height="200dp" 
        android:layout_alignParentBottom="true" android:layout_alignParentRight="true" android:layout_margin="20dp">
        <Button android:id="@+id/btnW" android:layout_width="65dp" android:layout_height="65dp" android:text="UP" android:layout_centerHorizontal="true" android:background="#55FFFFFF"/>
        <Button android:id="@+id/btnS" android:layout_width="65dp" android:layout_height="65dp" android:text="DOWN" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:background="#55FFFFFF"/>
        <Button android:id="@+id/btnA" android:layout_width="65dp" android:layout_height="65dp" android:text="LEFT" android:layout_alignParentLeft="true" android:layout_centerVertical="true" android:background="#55FFFFFF"/>
        <Button android:id="@+id/btnD" android:layout_width="65dp" android:layout_height="65dp" android:text="RIGHT" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:background="#55FFFFFF"/>
    </RelativeLayout>
</RelativeLayout>
